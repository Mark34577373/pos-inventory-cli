# Export these variables in your shell; .env is not loaded automatically.
TCCP_ENV=development
TCCP_DB_PATH=/absolute/path/to/tccp-demo.db
TCCP_TIMEZONE=America/Chicago
# Generate a private value with: python -c 'import secrets; print(secrets.token_hex(32))'
TCCP_SECRET_KEY=
TCCP_READ_ONLY=0
# 0/1 only. Defaults to 1 in development and 0 in production.
# Keep 0 for a restricted public portfolio deployment.
TCCP_ALLOW_REGISTRATION=1
TCCP_DEBUG=0
# Opt-in ONLY for the disposable Render Free public demo. See docs/RENDER_FREE.md.
TCCP_EPHEMERAL_DEMO=0
# Day 14: the private account area requires registration/login.
# Keep 1 for a fully read-only deployment; set 0 to allow authenticated owners
# to manage their own stores. Public demo sessions remain read-only either way.
# Login throttling and session revocation use the same persistent SQLite file.

# Production accepts only these explicit hosts (comma separated; no scheme/port).
# When omitted in production, only localhost/loopback hosts are trusted.
TCCP_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]

# Restricted hosted demo: explicitly use TCCP_ENV=production,
# TCCP_READ_ONLY=1 and TCCP_ALLOW_REGISTRATION=0. Set a stable private
# secret and an existing absolute database path on persistent local storage.
# See docs/DAY28_DEPLOYMENT_PREPARATION.md before provisioning or launching.
