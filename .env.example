# Export these variables in your shell; .env is not loaded automatically.
TCCP_ENV=development
TCCP_DB_PATH=/absolute/path/to/tccp-demo.db
TCCP_TIMEZONE=America/Chicago
# Generate a private value with: python -c 'import secrets; print(secrets.token_hex(32))'
TCCP_SECRET_KEY=
TCCP_READ_ONLY=0
TCCP_DEBUG=0
# Day 14: the private account area requires registration/login.
# Keep 1 for a fully read-only deployment; set 0 to allow authenticated owners
# to manage their own stores. Public demo sessions remain read-only either way.
# Login throttling and session revocation use the same persistent SQLite file.
